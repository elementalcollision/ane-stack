program(1.3)
{
    func frob<ios18>(tensor<fp16, [1, 48, 2, 1]> x0) {
        tensor<int32, [1]> ax = const()[val = tensor<int32, [1]>([1])];
        bool kd = const()[val = bool(true)];
        tensor<fp16, [1, 48, 2, 1]> z = reduce_mean(axes = ax, keep_dims = kd, x = x0)[name = string("z")];
    } -> (z);
}
