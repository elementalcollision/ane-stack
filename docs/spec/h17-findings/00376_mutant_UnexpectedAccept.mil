program(1.3)
{
    func frob<ios18>(tensor<fp16, [1, 48, 2, 1]> x0, tensor<fp16, [1, 48, 2, 1]> x1) {
        tensor<fp16, [1, 48, 2, 1]> t0 = mul(x = x0, y = x1)[name = string("t0")];
        tensor<fp16, [1, 48, 2, 1]> t0u = exp(x = t0)[name = string("t0u")];
        tensor<fp16, [1, 48, 2, 1]> t1 = mul(x = t0u, y = x1)[name = string("t1")];
        tensor<fp16, [1, 48, 2, 1]> t2 = sub(x = t1, y = x1)[name = string("t2")];
        tensor<fp16, [1, 48, 2, 1]> t2u = sigmoid(x = t2)[name = string("t2u")];
        tensor<fp16, [1, 48, 2, 1]> t3 = minimum(x = t2u, y = x1)[name = string("t3")];
        tensor<fp16, [1, 48, 2, 1]> t4 = add(x = t3, y = x1)[name = string("t4")];
    } -> (t4);
}
