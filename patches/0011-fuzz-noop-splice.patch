+// FORK(ane-stack): regression tests for the splice no-op fix (patch 0010).
+// The `const()→const(` splice used to silently no-op on bases with no
+// `const()` wrapper (ew_chain), producing a *valid* program that the frontend
+// accepts and the run misreports as an UnexpectedAccept hole.
+#[cfg(test)]
+mod tests {
+    use super::*;
+
+    /// Every mutation case must actually change the program text. A no-op
+    /// splice yields a valid program and a false UnexpectedAccept.
+    #[test]
+    fn mutations_always_change_the_text() {
+        let mut rng = Rng::new(0xF00D);
+        for id in 0..400 {
+            // drive the mutation path directly
+            let case = gen_mutation(&mut rng, id);
+            assert_ne!(
+                case.mil.trim(),
+                // regenerate the un-mutated base for comparison
+                match id % 4 {
+                    0 => gen_ew_chain(&mut Rng::new(0xF00D)).mil,
+                    1 => gen_conv(&mut Rng::new(0xF00D)).mil,
+                    2 => gen_layout(&mut Rng::new(0xF00D)).mil,
+                    _ => gen_softmax_reduce(&mut Rng::new(0xF00D)).mil,
+                }
+                .trim(),
+                "mutation {id} was a no-op (splice found no target)"
+            );
+        }
+    }
+
+    /// The specific regression: an ew_chain base has no `const()` wrapper, so
+    /// a `const()→const(` splice must fall back to a guaranteed-hit keyword
+    /// and still change the text.
+    #[test]
+    fn const_splice_on_constless_base_is_not_a_noop() {
+        // sweep ids that select the ew_chain base (id % 4 == 0) and the splice
+        // arm; assert the result is never byte-identical to the base.
+        for id in (0..200).step_by(4) {
+            let mut rng = Rng::new(id as u64 + 1);
+            let base = gen_ew_chain(&mut Rng::new(id as u64 + 1));
+            let case = gen_mutation(&mut rng, id);
+            if case.note.contains("const()") {
+                assert_ne!(
+                    case.mil, base.mil,
+                    "const() splice on constless base {id} was a no-op"
+                );
+            }
+        }
+    }
+}
